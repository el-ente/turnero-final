rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All writes happen through Cloud Functions using the Admin SDK, which
    // bypasses these rules entirely. Client-side Firestore access is
    // read-only real-time listeners (Totem/Display/Terminal/Admin views).

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Totem (ticket kiosk) and the public Display screen read these with no
    // login at all, so they stay open to anyone.
    match /sectors/{sectorId} {
      allow read: if true;
      allow write: if false;
    }

    match /queues/{queueId} {
      allow read: if true;
      allow write: if false;
    }

    match /terminals/{terminalId} {
      allow read: if true;
      allow write: if false;
    }

    match /turns/{turnId} {
      allow read: if true;
      allow write: if false;
    }

    // Staff profiles (role + sector assignment). A user can always read
    // their own doc (needed to bootstrap the UI after login); admin/
    // supervisor can read anyone's to run the Users admin screen.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || myRole() in ['admin', 'supervisor']);
      allow write: if false;
    }

    // Agenda module — fully independent of the collections above, see
    // docs/turnos-agendados-spec-2026-09-25.md. Services and blocks are
    // config, safe to read publicly (needed to show availability). Calls are
    // a PII-free mirror of appointments, built specifically to feed the
    // module's public announcement screen.
    match /appointmentServices/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /appointmentBlocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }

    match /appointmentCalls/{appointmentId} {
      allow read: if true;
      allow write: if false;
    }

    // Appointments hold PII (contactName/contact) — unlike turns, this is
    // NOT publicly readable. Clients read their own appointment through a
    // Cloud Function (appointmentId + memberNumber), not a live listener.
    match /appointments/{appointmentId} {
      allow read: if signedIn() && myRole() in ['admin', 'supervisor', 'cashier'];
      allow write: if false;
    }
  }
}
